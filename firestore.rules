rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Character sheets: any signed-in player reads, only the owner writes.
    match /chars/{charId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    // Private notes: the owner only.
    match /users/{uid}/secrets/{charId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
