rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The GM, by Firebase Auth user id. src/roles.ts (GM_UIDS) holds the same list: change both together.
    function isGM() {
      return request.auth != null && request.auth.uid in ['NS1EKdmeqNeSAYJ6NsNeTiRL1YI3', 'sPvYhHljb1hkwgThRhKKIwYcgOG3'];
    }
    // On another player's sheet the GM changes only health, radiation, conditions and gear.
    // src/roles.ts (GM_FIELDS) holds the same list of sheet fields.
    function gmFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['char', 'by', 'updatedAt'])
        && request.resource.data.char.diff(resource.data.char).affectedKeys().hasOnly([
          'hp', 'woundsTreated', 'bleed', 'rad',
          'vodka', 'noSleep', 'noFood', 'noWater',
          'money', 'armors', 'mask', 'weapons', 'items', 'artifacts',
          'updatedAt'
        ]);
    }

    // Character sheets: any signed-in player reads; the owner writes; the GM changes health and gear.
    match /chars/{charId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if (request.auth != null && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid)
                    || (isGM() && gmFieldsOnly());
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    // The GM's catalogue of things players take from: everyone reads, only the GM writes.
    match /catalog/{docId} {
      allow read: if request.auth != null;
      allow write: if isGM();
    }
    // The GM's NPC compendium (gm/npcs) and encounters: the GM only. Players never see enemy statblocks.
    match /gm/{docId} {
      allow read, write: if isGM();
    }
    match /encounters/{encId} {
      allow read, write: if isGM();
    }
    // Private notes: the owner only.
    match /users/{uid}/secrets/{charId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
